APP_NAME="ECommerce API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=ecommerce_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ---------- Mail ----------
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- AWS / S3 ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------- Sanctum ----------
SANCTUM_TOKEN_TTL_DAYS=7
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# ---------- ABA PayWay ----------
PAYWAY_MODE=sandbox
PAYWAY_SANDBOX_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_PRODUCTION_BASE_URL=https://checkout.payway.com.kh
PAYWAY_MERCHANT_ID=ec000000
PAYWAY_API_KEY=replace-with-payway-api-key
PAYWAY_RETURN_URL=${APP_URL}/api/v1/payments/return
PAYWAY_CANCEL_URL=${APP_URL}/api/v1/payments/cancel
PAYWAY_CONTINUE_SUCCESS_URL=${APP_URL}/payment/success
PAYWAY_RETURN_PARAMS=
PAYWAY_WEBHOOK_IPS=
# Currency the merchant profile accepts at PayWay (USD or KHR).
PAYWAY_CURRENCY=USD
# Used when the order is in USD but the PayWay merchant only accepts KHR.
PAYWAY_USD_TO_KHR_RATE=4100

# ---------- Firebase / FCM ----------
FIREBASE_CREDENTIALS=storage/app/firebase/firebase_credentials.json
FIREBASE_PROJECT_ID=
FCM_DEFAULT_TOPIC=promotions
FCM_DRY_RUN=false

# ---------- Horizon ----------
HORIZON_PREFIX=ecommerce_horizon:
HORIZON_DOMAIN=
HORIZON_PATH=horizon

# ---------- Throttle ----------
RATE_LIMIT_LOGIN=5
RATE_LIMIT_FORGOT_PASSWORD=3
RATE_LIMIT_API=60
